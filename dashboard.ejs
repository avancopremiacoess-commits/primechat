<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel DM</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <div>
        <p class="brand">Painel<span>DM</span></p>
        <h1>Suas contas</h1>
      </div>
      <div class="topbar-actions">
        <a href="/config/senha" class="btn btn-secondary btn-sm">Alterar senha</a>
        <form method="POST" action="/logout">
          <button type="submit" class="btn btn-secondary btn-sm">Sair</button>
        </form>
        <a href="/contas/nova" class="btn btn-primary">+ Nova conta</a>
      </div>
    </div>

    <% if (contas.length === 0) { %>
      <div class="empty">
        <p>Você ainda não cadastrou nenhuma conta de Instagram.</p>
        <a href="/contas/nova" class="btn btn-primary">Cadastrar a primeira</a>
      </div>
    <% } %>

    <% contas.forEach(function(conta) { %>
      <div class="conta-card">
        <div class="conta-header">
          <div class="avatar"><%= conta.nome.slice(0,2).toUpperCase() %></div>
          <div class="conta-nome"><%= conta.nome %></div>
          <span class="status <%= conta.ativo ? 'status-on' : 'status-off' %>">
            <%= conta.ativo ? 'Ativa' : 'Desativada' %>
          </span>
        </div>

        <p class="conta-texto"><%= conta.textoBase %></p>

        <label style="margin-top:0">URL do webhook (cole no External Request do Manychat desta conta)</label>
        <div class="webhook-box">
          <code id="url-<%= conta.id %>"><%= baseUrl %>/gerar-dm/<%= conta.id %>/<%= conta.token %></code>
          <button type="button" class="btn btn-secondary btn-sm" onclick="copiar('url-<%= conta.id %>')">Copiar</button>
        </div>

        <div class="conta-actions">
          <a href="/contas/<%= conta.id %>/editar" class="btn btn-secondary btn-sm">Editar</a>
          <form method="POST" action="/contas/<%= conta.id %>/regerar-token" onsubmit="return confirm('Gerar um novo link para esta conta? O link antigo deixará de funcionar — atualize no Manychat depois.');">
            <button type="submit" class="btn btn-secondary btn-sm">Gerar novo link</button>
          </form>
          <form method="POST" action="/contas/<%= conta.id %>/excluir" onsubmit="return confirm('Excluir esta conta? Essa ação não pode ser desfeita.');">
            <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>

  <script>
    function copiar(id) {
      const texto = document.getElementById(id).innerText;
      navigator.clipboard.writeText(texto);
    }
  </script>
</body>
</html>
